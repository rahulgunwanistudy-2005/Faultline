# Required for stable signed proof tokens across restarts or multiple workers.
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
FAULTLINE_PROOF_SECRET=

# Optional provider boundary. The verified demo does not require a provider key.
FEATHERLESS_API_KEY=

PORT=8000
FAULTLINE_CORS_ORIGINS=
FAULTLINE_MAX_UPLOAD_BYTES=8388608
FAULTLINE_MAX_IMAGE_PIXELS=20000000
FAULTLINE_PROOF_TTL_SECONDS=600
FAULTLINE_JOB_TTL_SECONDS=900
FAULTLINE_MAX_JOBS=100
FAULTLINE_DEMO_STAGE_MS=260
